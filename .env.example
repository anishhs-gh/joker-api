# Server Configuration
PORT=3000
CORS_ORIGIN=*
LOG_LEVEL=info

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Firebase Admin SDK (choose one method):
# Option 1: Path to service account key file
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./src/serviceAccountKey.json

# Option 2: Service account credentials as JSON string
# FIREBASE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account",...}

# Option 3: Use Application Default Credentials (ADC)
# Set GOOGLE_APPLICATION_CREDENTIALS env var or run on GCP
